# ---- Google Gemini (server only; never exposed to the browser) ----
GOOGLE_GENERATIVE_AI_API_KEY=            # Gemini API key from Google AI Studio
GEMINI_CHAT_MODEL=gemini-3.8-flash       # chat model used by the agent
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite # cheap model for reranking, classification, eval judging
GEMINI_EMBEDDING_MODEL=gemini-embedding-001 # embedding model (task types supported)
EMBEDDING_DIMENSIONS=768                 # embedding size; pgvector indexes allow at most 2000

# ---- Supabase Postgres (Step 4) ----
DATABASE_URL=                            # Supabase transaction pooler (port 6543), pasted WITHOUT ?sslmode=...&supa=... ; web app / Vercel
DATABASE_URL_SESSION=                    # same string on port 5432 (session pooler); scripts, migrations, GitHub Actions only — not on Vercel
MASTRA_DISABLE_STORAGE_INIT=false        # true on Vercel after `pnpm db:init` created the schema

# ---- Access control (Step 3) ----
APP_PASSWORD=                            # single shared password for the whole app
AUTH_SECRET=                             # 32+ random chars for signing the session cookie (openssl rand -base64 32)
CRON_SECRET=                             # 16+ random chars; Vercel sends it as a Bearer token to /api/cron/*

# ---- Community sources, tier 4 (disabled; no provider implemented) ----
COMMUNITY_PROVIDER=none                  # keep 'none'

# ---- Retrieval and safety switches ----
RETRIEVAL_RERANK=false                   # rerank retrieved chunks with the utility model
INPUT_GUARD=false                        # enable the LLM prompt-injection detector
STALE_AFTER_DAYS=30                      # warn when the source index is older than this
SOURCE_FETCH_USER_AGENT=                 # descriptive User-Agent with contact info for polite fetching of official sites

# ---- Ingestion pacing (Gemini free tier: 100 embedding requests per minute, each text counts) ----
EMBED_BATCH_SIZE=25                      # texts per embedding call (max 100)
EMBED_BATCH_DELAY_MS=16000               # pause between batches; set 0 with a paid key
